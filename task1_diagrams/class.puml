@startuml
skinparam classAttributeIconSize 0
skinparam classFontSize 13

class "Номер" {
  - id: int
  - категория: string
  - ценаЗаСутки: decimal
  - колвоМест: int
  - площадь: decimal
  - кондиционер: bool
  - телевизор: bool
  - холодильник: bool
  - wifi: bool
  - изображение: string
  + добавить()
  + изменить()
  + удалить()
}

class "ЗаявкаНаБронирование" {
  - id: int
  - имя: string
  - фамилия: string
  - телефон: string
  - email: string
  - датаЗаезда: date
  - датаВыезда: date
  - статус: enumeration
  - датаСоздания: datetime
  + создать()
  + изменитьСтатус()
}

enum "СтатусЗаявки" {
  Новая
  Одобрена
  Отклонена
}

class "КатегорияНомера" {
  - категория: string
}

class "Пользователь" <<abstract>> {
  - id: int
}

class "Гость" {
  + бронировать()
  + искатьНомер()
}

class "Администратор" {
  + просмотретьЗаявки()
  + изменитьСтатус()
  + управлятьКаталогом()
}

Пользователь <|-- Гость
Пользователь <|-- Администратор

"Номер" "1" -- "1" "КатегорияНомера" : имеет
"Номер" "1" -- "0..*" "ЗаявкаНаБронирование" : бронируется >
"ЗаявкаНаБронирование" -- "1" "СтатусЗаявки" : имеет
"Гость" "1" -- "0..*" "ЗаявкаНаБронирование" : создаёт >
"Администратор" "1" -- "0..*" "ЗаявкаНаБронирование" : обрабатывает
"Администратор" "1" -- "0..*" "Номер" : управляет

@enduml